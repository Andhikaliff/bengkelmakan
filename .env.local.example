# Copy file ini menjadi .env.local untuk development di komputer kamu.
# JANGAN commit file .env.local ke Git (sudah otomatis di-ignore lewat .gitignore).

# ── TAHAP 2: Database lokal (SQLite lewat Prisma) ───────────────────────────
# Path ke file database. Defaultnya taruh di dalam folder prisma/, satu file
# tunggal "dev.db" yang jadi seluruh isi database — data PERMANEN, tidak lagi
# hilang saat server di-restart (beda dari Tahap 1). Gampang di-backup: tinggal
# Path database SQLite relatif ke root project
DATABASE_URL="file:./prisma/dev.db"

# Hash password harus dibuat dengan langkah di README.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH="REPLACE_WITH_SCRYPT_HASH"

DATA_USERNAME=data
DATA_PASSWORD_HASH="REPLACE_WITH_SCRYPT_HASH"

# ── BACKUP OTOMATIS ──────────────────────────────────────────────────────────
# Folder tujuan backup; path relatif dari root project. Default: ../Backups
BACKUP_DIR=../Backups
# Berapa hari backup disimpan sebelum dihapus otomatis. Default: 30
BACKUP_RETENTION_DAYS=30

# ── MULTI-SCANNER KREDENSIAL ───────────────────────────────────────────
# Mendukung banyak scanner sekaligus. Format: SCANNER_{XX}_USERNAME
SCANNER_USERNAME=scanner
SCANNER_PASSWORD_HASH="REPLACE_WITH_SCRYPT_HASH"

SCANNER_01_USERNAME=scanner-01
SCANNER_01_PASSWORD_HASH="REPLACE_WITH_SCRYPT_HASH"

SCANNER_02_USERNAME=scanner-02
SCANNER_02_PASSWORD_HASH="REPLACE_WITH_SCRYPT_HASH"

# ── EMAIL REPORT (SMTP) ──────────────────────────────────────────────────────
# Secret key untuk mengamankan endpoint cronjob (dipanggil oleh Task Scheduler)
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET

# Konfigurasi SMTP (contoh pakai Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sender@example.com
SMTP_PASS=REPLACE_WITH_PROVIDER_APP_PASSWORD
REPORT_SENDER_NAME="Bengkel Makan System"

# Daftar penerima email laporan (pisahkan dengan koma jika lebih dari satu)
REPORT_RECIPIENTS=recipient@example.com
REPORT_CC=